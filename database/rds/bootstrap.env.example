# ============================================================
# BookStore Co. - RDS bootstrap configuration
#
# Copy this file to bootstrap.env and replace placeholders.
# Never commit bootstrap.env to Git.
#
# The three passwords below (DB_ADMIN_PASSWORD, APP_DB_PASSWORD and
# INGEST_DB_PASSWORD) can come from AWS Secrets Manager instead: run
# bootstrap-secrets.sh with DB_ADMIN_SECRET_ID, DB_APP_SECRET_ID and
# DB_INGEST_SECRET_ID defined, and the CHANGE_ME values are not used.
# ============================================================

DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=5432
DB_NAME=bookstore

DB_ADMIN_USER=bookstore_admin
DB_ADMIN_PASSWORD=CHANGE_ME

APP_DB_USER=bookstore_app
APP_DB_PASSWORD=CHANGE_ME

INGEST_DB_USER=bookstore_ingest
INGEST_DB_PASSWORD=CHANGE_ME

PGSSLMODE=require
